NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for account deletion (Settings → Delete account)
# Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Feature flags ---
# Production (beta): keep false. Preview/staging: set true to test Stripe.
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# --- Stripe (test mode only during beta — sk_test_ / pk_test_) ---
# Preview / local only until launch. Do not add live keys to production yet.
STRIPE_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_PRICE_ID=price_your_test_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional overrides (defaults to /dashboard/settings)
# STRIPE_CHECKOUT_SUCCESS_URL=https://your-preview.vercel.app/dashboard/settings?billing=success
# STRIPE_CHECKOUT_CANCEL_URL=https://your-preview.vercel.app/dashboard/settings?billing=cancel
# STRIPE_BILLING_PORTAL_RETURN_URL=https://your-preview.vercel.app/dashboard/settings
